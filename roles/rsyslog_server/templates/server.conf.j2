# rsyslog server config - listens for remote logs and stores per-host

module(load="imudp")
input(type="imudp" port="514")

module(load="imtcp")
input(type="imtcp" port="514")

template(name="RemoteLogs" type="string"
         string="{{ rsyslog_remote_dir }}/%HOSTNAME%/messages")

*.*  ?RemoteLogs
& stop
